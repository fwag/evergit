[alias]
	from-sha1 = "!f() { id=\"$1\"; r=\"${2:-$(git config evergit.remote || true)}\"; base=$(git config evergit.url || true); rem=\"\"; if [ -n \"$r\" ]; then rem=$(git remote get-url \"$r\" 2>/dev/null || true); fi; if [ -z \"$rem\" ]; then for cand in $(git remote 2>/dev/null); do curl_u=$(git remote get-url \"$cand\" 2>/dev/null || true); if [[ \"$curl_u\" == *evergit* ]]; then rem=\"$curl_u\"; break; fi; done; fi; if [ -z \"$rem\" ]; then rem=$(git remote get-url upstream 2>/dev/null || git remote get-url origin 2>/dev/null || true); fi; if [ -z \"$base\" ]; then if [[ \"$rem\" =~ ^https?://.* ]]; then base=$(echo \"$rem\" | grep -oE '^[a-zA-Z0-9+.-]+://[^/]+'); else base=\"https://evergit.suse.de\"; fi; fi; if [[ \"$base\" == */*.*/*/* ]]; then u=\"${base%/}\"; else if [ -z \"$rem\" ]; then echo \"Error: no valid remote found (specify remote: git from-sha1 <id> [remote])\" >&2; return 1; fi; p=$(echo \"$rem\" | sed -E \"s#^[a-zA-Z0-9+.-]+://[^/]+/##; s#^[a-zA-Z0-9._-]+@[^:]+:##; s#^/##\"); u=\"${base%/}/${p%/}\"; fi; curl -fsS \"$u/sha1/$id\"; }; f"
	to-sha1 = "!f() { arg1=\"$1\"; arg2=\"$2\"; rev=\"HEAD\"; r=\"\"; if [ -n \"$arg2\" ]; then rev=\"${arg1:-HEAD}\"; r=\"$arg2\"; elif [ -n \"$arg1\" ]; then if git remote get-url \"$arg1\" >/dev/null 2>&1 && ! git rev-parse --verify --quiet \"$arg1^{commit}\" >/dev/null 2>&1; then r=\"$arg1\"; else rev=\"$arg1\"; fi; fi; [ -z \"$r\" ] && r=$(git config evergit.remote || true); base=$(git config evergit.url || true); rem=\"\"; if [ -n \"$r\" ]; then rem=$(git remote get-url \"$r\" 2>/dev/null || true); fi; if [ -z \"$rem\" ]; then for cand in $(git remote 2>/dev/null); do curl_u=$(git remote get-url \"$cand\" 2>/dev/null || true); if [[ \"$curl_u\" == *evergit* ]]; then rem=\"$curl_u\"; break; fi; done; fi; if [ -z \"$rem\" ]; then rem=$(git remote get-url upstream 2>/dev/null || git remote get-url origin 2>/dev/null || true); fi; if [ -z \"$base\" ]; then if [[ \"$rem\" =~ ^https?://.* ]]; then base=$(echo \"$rem\" | grep -oE '^[a-zA-Z0-9+.-]+://[^/]+'); else base=\"https://evergit.suse.de\"; fi; fi; if [[ \"$base\" == */*.*/*/* ]]; then u=\"${base%/}\"; else if [ -z \"$rem\" ]; then echo \"Error: no valid remote found (specify remote: git to-sha1 [rev] [remote])\" >&2; return 1; fi; p=$(echo \"$rem\" | sed -E \"s#^[a-zA-Z0-9+.-]+://[^/]+/##; s#^[a-zA-Z0-9._-]+@[^:]+:##; s#^/##\"); u=\"${base%/}/${p%/}\"; fi; curl -fsS \"$u/sha256/$(git rev-parse \"$rev\")\"; }; f"

[evergit]
	# Placeholder: set when cloning over SSH or pointing to a custom Evergit instance URL
	# url = http://localhost:8080/github.com/owner/repo.git
	# remote = upstream
